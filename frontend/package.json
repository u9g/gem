{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/select": "^1.5.2",
    "expo": "~58.0.17",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@storybook/react-native-web-vite": "^10.6.3",
    "@types/react": "~19.3.0",
    "lucide-react": "^1.61.0",
    "storybook": "^10.6.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "scripts": {
    "generate": "mkdir -p gen && protoc -I ../protocol --plugin=protoc-gen-es=node_modules/.bin/protoc-gen-es --es_out=gen --es_opt=target=ts ../protocol/gem.proto",
    "prestart": "npm run generate",
    "start": "expo start --web",
    "prebuild": "npm run generate",
    "build": "expo export --platform web",
    "storybook": "npm run generate && storybook dev -p 6006",
    "build-storybook": "npm run generate && storybook build"
  },
  "private": true
}
